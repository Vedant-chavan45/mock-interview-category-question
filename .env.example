# Copy this file to .env. Keep your real .env out of Git and ZIP shares.

PORT=5001

# Local Ollama: no Ollama website API key is required.
AI_PROVIDER=ollama
# Groq is optional and only works within your account's current free-tier quotas.
# Set AI_PROVIDER=groq and GROQ_MODEL to a supported model to use hosted inference.
# Never commit or share your real key. Do not put it in browser JavaScript.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Use json_schema for best-effort JSON Schema on supported models.
# Switch to json_object if the API rejects schema constraints (application validators still run).
GROQ_RESPONSE_FORMAT=json_schema
# Reasoning effort applies to GPT-OSS models. Keep medium for quality-first trials.
GROQ_REASONING_EFFORT=medium
# Optional override; if unset, model gets a completion budget of at least 2048 tokens.
# GROQ_MAX_COMPLETION_TOKENS=2048
AI_PERF_LOG_ENABLED=0
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_KEEP_ALIVE=10m
# Per-request cap used by resume analysis and question generation (milliseconds).
OLLAMA_TIMEOUT_MS=120000
# Maximum time allowed for one submitted answer to be evaluated by Ollama (milliseconds).
ANSWER_EVALUATION_TIMEOUT_MS=120000
# Total question-generation deadline (milliseconds); this caps retries and streaming.
QUESTION_GENERATION_TIMEOUT_MS=90000
# Question-only JSON output keeps the model response compact.
QUESTION_GENERATION_NUM_PREDICT=512
QUESTION_GENERATION_NUM_CTX=4096
# Set to 1 to log safe request/validation categories while debugging.
DEBUG_QUESTION_GENERATION=0

# JWT authentication. Replace the sample value before exposing the server.
JWT_SECRET=replace-this-with-a-private-random-secret
JWT_EXPIRES_IN=4h

# Demo account seed. Development/demo only; change before using in a shared environment.
DEMO_USER_EMAIL=siddhant@capstone.demo
DEMO_USER_PASSWORD=demo1234
DEMO_USER_NAME=Siddhant Raikar
DEMO_USER_ID=000000000000000000000001

# MongoDB is required for `npm start` (web app); CLI resume evaluation does not use MongoDB.
MONGODB_URI=
MONGODB_DB_NAME=mock_interview_platform

# Integration tests must use a separate test database.
MONGODB_TEST_DB_NAME=mock_interview_platform_test

# Phase 2C: optional independent semantic question review (additional free-tier API calls).
# Keep 0 until the new reviewer has passed live quality and latency tests.
# Set 1 to reject category mismatches, fabricated events and keyword-only personalization.
AI_INTERVIEW_REVIEW_ENABLED=0

# Reliability and security hardening
# Same-origin UI is default; set only if a separate frontend needs CORS access.
# CORS_ALLOWED_ORIGINS=https://your-frontend.example
# Never publish the default demo user in production. Explicit opt-in only.
SEED_DEMO_USER=0
# Set NODE_ENV=production only after replacing the JWT secret with 32+ random bytes.
# NODE_ENV=production
# Only set when deployed behind a trusted proxy. Prevent forged client IP headers.
# TRUST_PROXY_HOPS=1
# Local development binds 127.0.0.1 by default. Production binds 0.0.0.0.
# HOST=127.0.0.1
